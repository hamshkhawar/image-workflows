steps:
- id: FileRenaming
  in:
    filePattern:
      wic_inline_input: '{row:c+}.*-.*{col:dd}.*wv\s*{c:c+}.*.tif'
    inpDir:
      wic_inline_input: /projects/SOD1/processed_data/test/CD_SOD1_2_E1023884 __1
    mapDirectory:
      wic_inline_input: ''
    outDir:
      wic_inline_input: rename.outDir
    outFilePattern:
      wic_inline_input: '{row:c}_{col:dd}_c{c:d+}.tif'
  out:
  - outDir:
      wic_anchor: inpDirOmeConverter
- id: OmeConverter
  in:
    filePattern:
      wic_inline_input: '{row:c}_{col:dd}_c{c:d+}.tif'
    inpDir:
      wic_alias: inpDirOmeConverter
    outDir:
      wic_inline_input: ome_converter.outDir
  out:
  - outDir:
      wic_anchor: inpDirBasicFlatfieldEstimation
- id: BasicFlatfieldEstimation
  in:
    filePattern:
      wic_inline_input: '{row:c}_{col:dd}_c{c:d+}.ome.tif'
    getDarkfield:
      wic_inline_input: true
    groupBy:
      wic_inline_input: c
    inpDir:
      wic_alias: inpDirBasicFlatfieldEstimation
    outDir:
      wic_inline_input: estimate_flatfield.outDir
  out:
  - outDir:
      wic_anchor: ffDirApplyFlatfield
- id: ApplyFlatfield
  in:
    dfPattern:
      wic_inline_input: A_\(01-10\)_c{c:d}_darkfield.ome.tif
    ffDir:
      wic_alias: ffDirApplyFlatfield
    ffPattern:
      wic_inline_input: A_\(01-10\)_c{c:d}_flatfield.ome.tif
    imgDir:
      wic_alias: inpDirBasicFlatfieldEstimation
    imgPattern:
      wic_inline_input: '{row:c}_{col:dd}_c{c:d+}.ome.tif'
    outDir:
      wic_inline_input: apply_flatfield.outDir
  out:
  - outDir:
      wic_anchor: inpDirKaggleNucleiSegmentation
- id: KaggleNucleiSegmentation
  in:
    filePattern:
      wic_inline_input: '{row:c}_{col:dd}_c0.ome.tif'
    inpDir:
      wic_alias: inpDirKaggleNucleiSegmentation
    outDir:
      wic_inline_input: kaggle_nuclei_segmentation.outDir
  out:
  - outDir:
      wic_anchor: inpDirFtlLabel
- id: FtlLabel
  in:
    binarizationThreshold:
      wic_inline_input: 0.5
    connectivity:
      wic_inline_input: '1'
    inpDir:
      wic_alias: inpDirFtlLabel
    outDir:
      wic_inline_input: ftl_plugin.outDir
  out:
  - outDir:
      wic_anchor: segDirNyxusPlugin
- id: NyxusPlugin
  in:
    features:
      wic_inline_input: MEAN
    fileExtension:
      wic_inline_input: arrowipc
    inpDir:
      wic_alias: inpDirKaggleNucleiSegmentation
    intPattern:
      wic_inline_input: '{row:c}_{col:dd}_c{c:d+}.ome.tif'
    neighborDist:
      wic_inline_input: 5
    outDir:
      wic_inline_input: nyxus_plugin.outDir
    pixelPerMicron:
      wic_inline_input: 1.0
    segDir:
      wic_alias: segDirNyxusPlugin
    segPattern:
      wic_inline_input: '{row:c}_{col:dd}_c0.ome.tif'
  out:
  - outDir:
      wic_anchor: inpDirTabularFeatureConcat
- id: TabularFeatureConcat
  in:
    channelName:
      wic_inline_input: c
    filePattern:
      wic_inline_input: '{row:c}_{col:dd}_c{c:d+}.arrow'
    groupBy:
      wic_inline_input: row,col
    inpDir:
      wic_alias: inpDirTabularFeatureConcat
    metaDir:
      wic_inline_input: /projects/SOD1/processed_data/meta/
    outDir:
      wic_inline_input: tabular_feat.outDir
    plateName:
      wic_inline_input: CD_SOD1_2_E1023884__1
  out:
  - outDir:
      wic_anchor: inpDirTabularThresholdingPlugin
- id: TabularThresholdingPlugin
  in:
    falsePositiverate:
      wic_inline_input: 0.01
    filePattern:
      wic_inline_input: .*.arrow
    inpDir:
      wic_alias: inpDirTabularThresholdingPlugin
    n:
      wic_inline_input: 3
    negControl:
      wic_inline_input: neg_controls
    numBins:
      wic_inline_input: 512
    outDir:
      wic_inline_input: tabular_thresh.outDir
    posControl:
      wic_inline_input: pos_controls
    thresholdType:
      wic_inline_input: all
    varName:
      wic_inline_input: C1_MEAN
  out:
  - outDir:
      wic_anchor: inpDirTabularStatistics
- id: TabularStatistics
  in:
    filePattern:
      wic_inline_input: '{row:c}_{col:dd}_c{c:d+}.ome.tif'
    groupBy:
      wic_inline_input: row,col
    inpDir:
      wic_alias: inpDirTabularStatistics
    outDir:
      wic_inline_input: tabular_stat.outDir
    statistics:
      wic_inline_input: mean,count,prop
  out: []
